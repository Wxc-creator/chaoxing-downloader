{
  "manifest_version": 3,
  "name": "超星学习通课件与资料下载助手",
  "short_name": "超星下载助手",
  "version": "1.2.1",
  "description": "一键提取并下载超星学习通/泛雅平台的课件(PPT/PDF/Word/Excel)、课程资料、音视频及作业附件，解除教师禁止下载限制与预览隐藏。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "超星下载助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.fanya.chaoxing.com/*",
    "*://*.ananas.chaoxing.com/*",
    "*://*.cldisk.com/*",
    "*://*.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.edu.cn/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "icons/*"
      ],
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.edu.cn/*"
      ]
    }
  ]
}
